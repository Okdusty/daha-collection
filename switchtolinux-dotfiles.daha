# Drafted by `daha-cli import` from https://github.com/switchToLinux/dotfiles.git at 8f38d0457a27da279037450a6bb77aa0175a9853.
# Their files stay in their repository: this pack points at them.
# A draft: review every op before publishing.
#   left out: hyprland: 63 bind, 6 bindel, 4 bindl, 2 bindm, 2 dwindle settings, 19 env, 8 exec-once, 3 general settings, 3 gestures settings, 9 input settings, 1 master settings, 1 monitor, 9 windowrule, 1 xwayland settings (not theme: binds, startup commands, monitors, input and the like)
#   left out: hyprpaper: its wallpaper /video/movies/sources/图片素材库/wallpaper/故宫博物院/wallpaper/4k_257544_爱上紫禁城-海棠.jpg isn't in their repository
#   left out: rofi: its theme "fancy2" isn't in their repository
#   left out: dunst: 47 settings that aren't its theme
#   left out: hyprlock: found hypr/hyprlock.conf, but the importer doesn't read hyprlock yet
#   left out: mako: found mako/config, but the importer doesn't read mako yet

daha = 1

[pack]
authors = [ "switchToLinux" ]
description = "Taken from switchToLinux/dotfiles at 8f38d0457a27, referenced there and not copied: only what themes an app.\n\n- hyprland: hypr/hyprland.conf and 12 file(s) it sources: 35 settings, 23 animation lines\n- dunst: dunst/dunstrc: 17 settings\n- wofi: wofi/style.css (the whole style)\n\nLeft out: binds, startup commands, monitors, scripts and anything outside their repository."
desktops = [ "hyprland" ]
id = "com.github.okdusty.switchtolinux-dotfiles"
license = "GPL-3.0"
name = "switchToLinux's dotfiles"
preview = [ "i3wm-demo1", "hyprland-demo1" ]
summary = "switchToLinux's rice: its look for hyprland, dunst and wofi"
version = "1.0.0"

[source]
publishers = [ "gitlab.com/okdusty" ]
ref = "main"
repo = "https://github.com/Okdusty/daha-collection.git"

[upstream]
commit = "8f38d0457a27da279037450a6bb77aa0175a9853"
ref = "main"
repo = "https://github.com/switchToLinux/dotfiles.git"

[[apps.dunst.ops]]
