set = "rgba(00000088)"

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "shadow", "offset" ]
priority = 50
set = [ 0, 10 ]

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "blur", "enabled" ]
