# Drafted by `daha-cli import` from https://github.com/RumiAxolotl/Axolotl-hyprland.git at c0a867e195da3fb468935304b29913f1116a57ed.
# Their files stay in their repository: this pack points at them.
# A draft: review every op before publishing.
#   left out: hyprland: 1 cursor settings, 2 dwindle settings, 2 general settings, 5 input settings, 3 misc settings, 1 opengl settings, 5 hl.animation calls, 58 hl.bind calls, 1 hl.curve calls, 1 hl.device calls, 5 hl.env calls, 1 hl.gesture calls, 2 hl.monitor calls, 2 hl.on calls (not theme, or animations, which aren't taken from Lua yet)
#   left out: hyprland: 6 parts of its Lua need running to read (keybind:197: a for block isn't read (it would need running), ...)
#   left out: kitty: 41 keyboard shortcuts, 25 other settings
#   left out: gtk3: its style @imports other files, which won't be next to it: review it
#   left out: gtk4: its style @imports other files, which won't be next to it: review it
#   left out: fastfetch: found dotfiles/fastfetch/config.jsonc, but the importer doesn't read fastfetch yet

daha = 1

[pack]
authors = [ "RumiAxolotl" ]
description = "Taken from RumiAxolotl/Axolotl-hyprland at c0a867e195da, referenced there and not copied: only what themes an app.\n\n- hyprland: dotfiles/hypr/hyprland.lua and 4 module(s) it requires: 27 settings (read from its Lua, not run)\n- kitty: dotfiles/kitty/kitty.conf and 1 included file(s): 38 settings\n- rofi: dotfiles/rofi/noctalia.rasi (its theme)\n- btop: dotfiles/btop/themes/noctalia.theme (its theme, installed as btop's \"daha\" theme)\n- cava: dotfiles/cava/config: 10 settings\n- wlogout: dotfiles/wlogout/style.css (the whole style)\n- gtk3: dotfiles/gtk-3.0/gtk.css (the whole style)\n- gtk4: dotfiles/gtk-4.0/gtk.css (the whole style)\n\nLeft out: binds, startup commands, monitors, scripts and anything outside their repository."
desktops = [ "hyprland" ]
id = "com.github.okdusty.rumiaxolotl-axolotl-hyprland"
license = "MIT"
name = "Axolotl-hyprland"
preview = [ "dark", "dark1", "dark2" ]
summary = "RumiAxolotl's rice: its look for hyprland, kitty, rofi, btop, cava, wlogout, gtk3 and gtk4"
version = "1.0.0"

[source]
publishers = [ "gitlab.com/okdusty" ]
ref = "main"
repo = "https://github.com/Okdusty/daha-collection.git"

[upstream]
commit = "c0a867e195da3fb468935304b29913f1116a57ed"
ref = "main"
repo = "https://github.com/RumiAxolotl/Axolotl-hyprland.git"

[requires]
fonts = [ "JetBrainsMono Nerd Fonts" ]

[[apps.btop.ops]]
fragment = "noctalia-2"
priority = 70
target = "theme"

[[apps.cava.ops]]
group = "colors"
key = [ "color", "theme" ]
priority = 80
set = "\"noctalia\""

[[apps.cava.ops]]
