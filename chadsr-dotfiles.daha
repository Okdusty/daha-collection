# Drafted by `daha-cli import` from https://github.com/chadsr/dotfiles.git at e0a6eca15e47cea83f2611fad1704c46c2c85f42.
# Their files stay in their repository: this pack points at them.
# A draft: review every op before publishing.
#   left out: hyprland: 4 cursor settings, 1 dwindle settings, 3 ecosystem settings, 2 general settings, 5 input settings, 1 master settings, 1 misc settings, 1 xwayland settings, 8 hl.animation calls, 90 hl.bind calls, 4 hl.curve calls, 5 hl.env calls, 2 hl.gesture calls, 6 hl.layer_rule calls, 2 hl.monitor calls, 1 hl.on calls, 5 hl.permission calls, 13 hl.window_rule calls (not theme, or animations, which aren't taken from Lua yet)
#   left out: hyprland: 3 parts of its Lua need running to read (themes/theme:1: require("themes.catppuccin-mocha"): not in the repository, ...)
#   left out: waybar: its style @imports other files, which won't be next to it: review the colours
#   left out: waybar: its config (modules, layout) isn't imported: that's a desktop, not a theme
#   left out: btop: its theme catppuccin_mocha.theme isn't in their repository (btop's own themes aren't packed)
#   left out: fuzzel: 13 settings that aren't its theme
#   left out: dunst: 12 settings that aren't its theme
#   left out: alacritty: found alacritty/.config/alacritty/alacritty.toml, but the importer doesn't read alacritty yet
#   left out: ghostty: found ghostty/.config/ghostty/config, but the importer doesn't read ghostty yet
#   left out: gtk3: found gtk/.config/gtk-3.0/settings.ini, but the importer doesn't read gtk3 yet
#   left out: gtk4: found gtk/.config/gtk-4.0/settings.ini, but the importer doesn't read gtk4 yet
#   left out: hyprlock: found hyprland/.config/hypr/hyprlock.conf, but the importer doesn't read hyprlock yet
#   left out: mako: found mako/.config/mako/config, but the importer doesn't read mako yet
#   left out: qt6ct: found qt/.config/qt6ct/qt6ct.conf, but the importer doesn't read qt6ct yet
#   left out: sway: found sway/.config/sway/config, but the importer doesn't read sway yet

daha = 1

[pack]
authors = [ "chadsr" ]
description = "Taken from chadsr/dotfiles at e0a6eca15e47, referenced there and not copied: only what themes an app.\n\n- hyprland: hyprland/.config/hypr/hyprland.lua and 7 module(s) it requires: 22 settings (read from its Lua, not run)\n- waybar: waybar/.config/waybar/style.css (the whole style)\n- cava: cava/.config/cava/config: 9 settings\n- fuzzel: fuzzel/.config/fuzzel/fuzzel.ini: 9 settings\n- dunst: dunst/.config/dunst/dunstrc: 13 settings\n- swaync: swaync/.config/swaync/style.css (the whole style)\n- wlogout: wlogout/.config/wlogout/style.css (the whole style)\n\nLeft out: binds, startup commands, monitors, scripts and anything outside their repository."
desktops = [ "hyprland" ]
id = "com.github.okdusty.chadsr-dotfiles"
license = "MIT"
name = "chadsr's dotfiles"
preview = [ "hypr" ]
summary = "chadsr's rice: its look for hyprland, waybar, cava, fuzzel, dunst, swaync and wlogout"
version = "1.0.0"

[source]
publishers = [ "gitlab.com/okdusty" ]
ref = "main"
repo = "https://github.com/Okdusty/daha-collection.git"

[upstream]
commit = "e0a6eca15e47cea83f2611fad1704c46c2c85f42"
ref = "main"
repo = "https://github.com/chadsr/dotfiles.git"

