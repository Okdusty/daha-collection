priority = 50
set = "0.8"

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "blur", "brightness" ]
priority = 50
set = "0.8"

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "blur", "vibrancy" ]
priority = 50
set = "0.1"

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "blur", "vibrancy_darkness" ]
priority = 50
set = "0.0"

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "blur", "popups" ]
priority = 50
set = false

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "blur", "special" ]
priority = 50
set = false

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "shadow", "enabled" ]
priority = 50
set = true

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "shadow", "range" ]
priority = 50
set = 4

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "shadow", "render_power" ]
priority = 50
set = 2

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "shadow", "scale" ]
priority = 50
set = "1.0"

[[apps.hyprland.ops]]
group = "layout"
key = [ "general", "gaps_in" ]
priority = 60
set = 5

[[apps.hyprland.ops]]
group = "layout"
key = [ "general", "gaps_out" ]
priority = 60
set = 8

[[apps.hyprland.ops]]
group = "layout"
