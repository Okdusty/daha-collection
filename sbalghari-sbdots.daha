[[apps.hyprland.ops]]
group = "misc"
key = [ "misc", "force_default_wallpaper" ]
priority = 30
set = 0

[[apps.hyprland.ops]]
group = "misc"
key = [ "misc", "disable_hyprland_logo" ]
priority = 30
set = true

[[apps.kitty.ops]]
group = "font"
key = "font_family"
priority = 60
set = "JetBrainsMono Nerd Font"

[[apps.kitty.ops]]
group = "font"
key = "bold_font"
priority = 60
set = "JetBrainsMono NF Bold"

[[apps.kitty.ops]]
group = "font"
key = "italic_font"
priority = 60
set = "JetBrainsMono NF Italic"

[[apps.kitty.ops]]
group = "font"
key = "bold_italic_font"
priority = 60
set = "JetBrainsMono NF Medium Italic"

[[apps.kitty.ops]]
group = "font"
key = "font_size"
priority = 60
set = 11

[[apps.kitty.ops]]
group = "window"
key = "window_margin_width"
priority = 50
set = 0

[[apps.kitty.ops]]
group = "window"
key = "single_window_margin_width"
priority = 50
set = -1

[[apps.kitty.ops]]
group = "window"
key = "window_padding_width"
priority = 50
