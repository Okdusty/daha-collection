set = "\"#89b4fa\""

[[apps.dunst.ops]]
group = "font"
key = [ "global", "font" ]
priority = 60
set = "NotoSans Nerd Font 17"

[[apps.dunst.ops]]
group = "spacing"
key = [ "global", "icon_theme" ]
priority = 50
set = "\"breeze, Adwaita\""

[[apps.dunst.ops]]
