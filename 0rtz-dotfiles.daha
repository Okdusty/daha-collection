# Drafted by `daha-cli import` from https://github.com/0rtz/dotfiles.git at 4373c90582b171ba76f2b5953ef7084aaf0a178d.
# Their files stay in their repository: this pack points at them.
# A draft: review every op before publishing.
#   left out: hyprland: 1 binds settings, 1 cursor settings, 1 dwindle settings, 2 ecosystem settings, 1 general settings, 1 group settings, 5 input settings, 1 misc settings, 4 hl.animation calls, 43 hl.bind calls, 13 hl.env calls, 2 hl.layer_rule calls, 1 hl.on calls, 9 hl.window_rule calls, 2 hl.workspace_rule calls (not theme, or animations, which aren't taken from Lua yet)
#   left out: hyprland: 11 parts of its Lua need running to read (conf.workspaces:30: a call to move_to_workspace isn't run, ...)
#   left out: waybar: its config (modules, layout) isn't imported: that's a desktop, not a theme
#   left out: alacritty: desktop/.config/alacritty/themes/github_dark_high_contrast.toml is added at the end of alacritty.toml: a table the user has too would be defined twice; review
#   left out: dunst: 48 settings that aren't its theme
#   left out: hyprlock: found desktop/.config/hypr/hyprlock.conf, but the importer doesn't read hyprlock yet
#   left out: sway: found desktop/.config/sway/config, but the importer doesn't read sway yet

daha = 1

[pack]
authors = [ "0rtz" ]
description = "Taken from 0rtz/dotfiles at 4373c90582b1, referenced there and not copied: only what themes an app.\n\n- hyprland: desktop/.config/hypr/hyprland.lua and 5 module(s) it requires: 22 settings (read from its Lua, not run)\n- waybar: desktop/.config/waybar/style.css (the whole style)\n- rofi: desktop/.config/rofi/theme.rasi (its theme)\n- alacritty: desktop/.config/alacritty/themes/github_dark_high_contrast.toml (a colour theme it imports)\n- dunst: desktop/.config/dunst/dunstrc: 18 settings\n\nLeft out: binds, startup commands, monitors, scripts and anything outside their repository."
desktops = [ "hyprland" ]
id = "com.github.okdusty.0rtz-dotfiles"
license = "MIT"
name = "0rtz's dotfiles"
summary = "0rtz's rice: its look for hyprland, waybar, rofi, alacritty and dunst"
version = "1.0.0"

[source]
publishers = [ "gitlab.com/okdusty" ]
ref = "main"
repo = "https://github.com/Okdusty/daha-collection.git"

[upstream]
commit = "4373c90582b171ba76f2b5953ef7084aaf0a178d"
ref = "main"
repo = "https://github.com/0rtz/dotfiles.git"

[[apps.alacritty.ops]]
fragment = "github-dark-high-contrast"
priority = 70

[[apps.dunst.ops]]
group = "spacing"
key = [ "global", "transparency" ]
priority = 50
set = 0

[[apps.dunst.ops]]
group = "spacing"
key = [ "global", "padding" ]
priority = 50
set = 16

[[apps.dunst.ops]]
group = "spacing"
key = [ "global", "horizontal_padding" ]
priority = 50
set = 20

[[apps.dunst.ops]]
group = "spacing"
key = [ "global", "frame_width" ]
priority = 50
set = 2

[[apps.dunst.ops]]
group = "spacing"
key = [ "global", "gap_size" ]
priority = 50
set = 8

[[apps.dunst.ops]]
group = "spacing"
key = [ "global", "corner_radius" ]
priority = 50
set = 12

[[apps.dunst.ops]]
group = "colors"
key = [ "global", "separator_color" ]
priority = 80
set = "frame"

[[apps.dunst.ops]]
group = "colors"
key = [ "global", "frame_color" ]
priority = 80
set = "\"#89b4fa\""

[[apps.dunst.ops]]
