# Drafted by `daha-cli import` from https://github.com/Satoxyan/HyprWNC.git at 2c0cf55636b1e204ce87238a5af11a8068ccab95.
# Their files stay in their repository: this pack points at them.
# A draft: review every op before publishing.
#   left out: hyprland: 127 bind, 4 binde, 2 bindel, 1 bindir, 17 bindl, 4 bindle, 2 bindm, 2 bindr, 1 binds settings, 3 dwindle settings, 8 env, 16 exec-once, 4 general settings, 8 gestures settings, 10 input settings, 44 layerrule, 9 misc settings, 1 monitor, 18 plugin settings, 47 windowrulev2 (not theme: binds, startup commands, monitors, input and the like)
#   left out: kitty: 9 keyboard shortcuts, 4 other settings
#   left out: cava: 9 settings that aren't its theme
#   left out: foot: 24 settings that aren't its theme
#   left out: fuzzel: 6 settings that aren't its theme
#   left out: hyprlock: found .config/hypr/hyprlock.conf, but the importer doesn't read hyprlock yet
#   left out: qt5ct: found .config/qt5ct/qt5ct.conf, but the importer doesn't read qt5ct yet
#   left out: qt6ct: found .config/qt6ct/qt6ct.conf, but the importer doesn't read qt6ct yet

daha = 1

[pack]
authors = [ "Satoxyan" ]
description = "Taken from Satoxyan/HyprWNC at 2c0cf55636b1, referenced there and not copied: only what themes an app.\n\n- hyprland: .config/hypr/hyprland.conf and 11 file(s) it sources: 31 settings, 25 animation lines\n- kitty: .config/kitty/kitty.conf: 7 settings\n- cava: .config/cava/config: 11 settings\n- foot: .config/foot/foot.ini: 1 settings\n- fuzzel: .config/fuzzel/fuzzel.ini: 2 settings\n- wlogout: .config/wlogout/style.css (the whole style)\n\nLeft out: binds, startup commands, monitors, scripts and anything outside their repository."
desktops = [ "hyprland" ]
id = "com.github.okdusty.satoxyan-hyprwnc"
license = "GPL-3.0"
name = "HyprWNC"
preview = [ "sample" ]
summary = "Satoxyan's rice: its look for hyprland, kitty, cava, foot, fuzzel and wlogout"
version = "1.0.0"

[source]
publishers = [ "gitlab.com/okdusty" ]
ref = "main"
repo = "https://github.com/Okdusty/daha-collection.git"

[upstream]
commit = "2c0cf55636b1e204ce87238a5af11a8068ccab95"
ref = "main"
repo = "https://github.com/Satoxyan/HyprWNC.git"

[requires]
fonts = [ "SpaceMono Nerd Font" ]

[[apps.cava.ops]]
group = "colors"
key = [ "color", "foreground" ]
priority = 80
set = "'#A6C8FF'"

