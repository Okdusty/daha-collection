# Drafted by `daha-cli import` from https://github.com/AnanyTanwar/hyprland-dotfiles.git at 2938f2758dfccdcfa965474004cb8dc58bec816d.
# Their files stay in their repository: this pack points at them.
# A draft: review every op before publishing.
#   left out: hyprland: 34 bind, 2 bindm, 3 exec-once, 3 general settings, 10 input settings, 6 layerrule, 1 misc settings, 2 monitor, 10 workspace (not theme: binds, startup commands, monitors, input and the like)
#   left out: kitty: 6 other settings
#   left out: waybar: its config (modules, layout) isn't imported: that's a desktop, not a theme
#   left out: rofi: config/rofi/config.rasi names no theme file (@theme or @import): its settings aren't a theme
#   left out: alacritty: its colours are in config/alacritty/alacritty.toml itself, and daha can't take single TOML settings yet (only theme files it imports)
#   left out: btop: its theme current.theme isn't in their repository (btop's own themes aren't packed)
#   left out: cava: 14 settings that aren't its theme
#   left out: hyprlock: found config/hypr/hyprlock.conf, but the importer doesn't read hyprlock yet

daha = 1

[pack]
authors = [ "AnanyTanwar" ]
description = "Taken from AnanyTanwar/hyprland-dotfiles at 2938f2758dfc, referenced there and not copied: only what themes an app.\n\n- hyprland: config/hypr/hyprland.conf and 10 file(s) it sources: 27 settings\n- kitty: config/kitty/kitty.conf and 1 included file(s): 37 settings\n- waybar: config/waybar/style.css (the whole style)\n- cava: config/cava/config: 8 settings\n- swaync: config/swaync/style.css (the whole style)\n\nLeft out: binds, startup commands, monitors, scripts and anything outside their repository."
desktops = [ "hyprland" ]
id = "com.github.okdusty.ananytanwar-hyprland-dotfiles"
license = "MIT"
name = "AnanyTanwar's hyprland-dotfiles"
preview = [ "tokyonight-main", "tokyo-dev", "cat-main" ]
summary = "AnanyTanwar's rice: its look for hyprland, kitty, waybar, cava and swaync"
version = "1.0.0"

[source]
publishers = [ "gitlab.com/okdusty" ]
ref = "main"
repo = "https://github.com/Okdusty/daha-collection.git"

[upstream]
commit = "2938f2758dfccdcfa965474004cb8dc58bec816d"
ref = "main"
repo = "https://github.com/AnanyTanwar/hyprland-dotfiles.git"

[requires]
fonts = [ "Agave Nerd Font Mono" ]

[[apps.cava.ops]]
