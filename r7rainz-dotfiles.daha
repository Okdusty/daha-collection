# Drafted by `daha-cli import` from https://github.com/R7rainz/dotfiles.git at 1525875fa2c02fb26d05463fa64108c00b8dacbe.
# Their files stay in their repository: this pack points at them.
# A draft: review every op before publishing.
#   left out: hyprland: 57 bind, 2 bindm, 5 dwindle settings, 2 exec-once, 3 general settings, 8 gesture, 12 input settings, 2 master settings, 4 misc settings, 1 monitor, 9 windowrule, 12 windowrule settings, 3 workspace (not theme: binds, startup commands, monitors, input and the like)
#   left out: hyprland: `source = /home/rainz/.config/hypr/noctalia/noctalia-colors.conf` isn't in their repository
#   left out: kitty: 18 keyboard shortcuts, 19 other settings
#   left out: waybar: its config (modules, layout) isn't imported: that's a desktop, not a theme
#   left out: swaync: its style @imports other files, which won't be next to it: review it
#   left out: fastfetch: found .config/fastfetch/config.jsonc, but the importer doesn't read fastfetch yet
#   left out: ghostty: found .config/ghostty/config, but the importer doesn't read ghostty yet
#   left out: hyprlock: found .config/hypr/hyprlock.conf, but the importer doesn't read hyprlock yet
#   left out: mako: found .config/mako/config, but the importer doesn't read mako yet

daha = 1

[pack]
authors = [ "R7rainz" ]
description = "Taken from R7rainz/dotfiles at 1525875fa2c0, referenced there and not copied: only what themes an app.\n\n- hyprland: .config/hypr/hyprland.conf: 32 settings, 17 animation lines\n- kitty: .config/kitty/kitty.conf: 40 settings\n- waybar: .config/waybar/style.css (the whole style)\n- swaync: .config/swaync/style.css (the whole style)\n\nLeft out: binds, startup commands, monitors, scripts and anything outside their repository."
desktops = [ "hyprland" ]
id = "com.github.okdusty.r7rainz-dotfiles"
license = "MIT"
name = "R7rainz's dotfiles"
preview = [ "preview", "preview-2", "preview-3" ]
summary = "R7rainz's rice: its look for hyprland, kitty, waybar and swaync"
version = "1.0.0"

[source]
publishers = [ "gitlab.com/okdusty" ]
ref = "main"
repo = "https://github.com/Okdusty/daha-collection.git"

[upstream]
commit = "1525875fa2c02fb26d05463fa64108c00b8dacbe"
ref = "master"
repo = "https://github.com/R7rainz/dotfiles.git"

[requires]
fonts = [ "JetBrains Mono Nerd Font" ]

[[apps.hyprland.ops]]
group = "layout"
key = [ "general", "gaps_in" ]
priority = 60
set = 5

