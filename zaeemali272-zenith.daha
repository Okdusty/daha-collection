# Drafted by `daha-cli import` from https://github.com/zaeemali272/zenith.git at 74b03eb6bd9df961b4f450ad57ef055b7b8f3865.
# Their files stay in their repository: this pack points at them.
# A draft: review every op before publishing.
#   left out: kitty: 13 keyboard shortcuts, 3 other settings

daha = 1

[pack]
authors = [ "zaeemali272" ]
description = "Taken from zaeemali272/zenith at 74b03eb6bd9d, referenced there and not copied: only what themes an app.\n\n- kitty: .config/kitty/kitty.conf and 1 included file(s): 31 settings\n\nLeft out: binds, startup commands, monitors, scripts and anything outside their repository."
id = "com.github.okdusty.zaeemali272-zenith"
license = "Unlicense"
name = "zenith"
preview = [ "2026-05-25-113908-hyprshot", "2026-05-25-113646-hyprshot", "2026-05-25-113837-hyprshot" ]
summary = "zaeemali272's rice: its look for kitty"
version = "1.0.0"

[source]
publishers = [ "gitlab.com/okdusty" ]
ref = "main"
repo = "https://github.com/Okdusty/daha-collection.git"

[upstream]
commit = "74b03eb6bd9df961b4f450ad57ef055b7b8f3865"
ref = "main"
repo = "https://github.com/zaeemali272/zenith.git"

[requires]
fonts = [ "JetBrains Mono Nerd Font" ]

[[apps.kitty.ops]]
group = "colors"
key = "foreground"
priority = 80
set = "#ebe1d4"

