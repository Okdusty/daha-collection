# Drafted by `daha-cli import` from https://github.com/yurihikari/garuda-hyprdots.git at 8f7a32fcea57621b15f4325d4b8bb97624b61833.
# Their files stay in their repository: this pack points at them.
# A draft: review every op before publishing.
#   left out: hyprland: 104 bind, 8 binde, 2 bindl, 2 bindm, 4 binds settings, 5 debug settings, 6 dwindle settings, 1 exec-once, 1 general settings, 1 gesture, 6 gestures settings, 27 input settings, 1 layerrule, 3 master settings, 10 misc settings, 1 monitor, 41 windowrule settings (not theme: binds, startup commands, monitors, input and the like)
#   left out: kitty: 5 other settings
#   left out: waybar: its style @imports other files, which won't be next to it: review the colours
#   left out: waybar: its config (modules, layout) isn't imported: that's a desktop, not a theme
#   left out: alacritty: its colours are in alacritty/alacritty.toml itself, and daha can't take single TOML settings yet (only theme files it imports)
#   left out: cava: 4 settings that aren't its theme
#   left out: foot: 13 settings that aren't its theme
#   left out: wlogout: its style @imports other files, which won't be next to it: review it
#   left out: fastfetch: found fastfetch/config.jsonc, but the importer doesn't read fastfetch yet
#   left out: gtk3: found gtk-3.0/settings.ini, but the importer doesn't read gtk3 yet
#   left out: hyprlock: found hypr/hyprlock.conf, but the importer doesn't read hyprlock yet
#   left out: mako: found mako/config, but the importer doesn't read mako yet

daha = 1

[pack]
authors = [ "yurihikari" ]
description = "Taken from yurihikari/garuda-hyprdots at 8f7a32fcea57, referenced there and not copied: only what themes an app.\n\n- hyprland: hypr/hyprland.conf and 1 file(s) it sources: 16 settings, 10 animation lines\n- kitty: kitty/kitty.conf and 1 included file(s): 44 settings\n- waybar: waybar/style.css (the whole style)\n- rofi: rofi/basic/.local/share/rofi/themes/catppuccin-mocha.rasi (its theme)\n- cava: cava/config: 6 settings\n- foot: hypr/foot/foot.ini: 1 settings\n- wlogout: hypr/wlogout/style.css (the whole style)\n- wofi: wofi/style.css (the whole style)\n\nLeft out: binds, startup commands, monitors, scripts and anything outside their repository."
desktops = [ "hyprland" ]
id = "com.github.okdusty.yurihikari-garuda-hyprdots"
license = "MIT"
name = "garuda-hyprdots"
summary = "yurihikari's rice: its look for hyprland, kitty, waybar, rofi, cava, foot, wlogout and wofi"
version = "1.0.0"

[source]
publishers = [ "gitlab.com/okdusty" ]
ref = "main"
repo = "https://github.com/Okdusty/daha-collection.git"

[upstream]
commit = "8f7a32fcea57621b15f4325d4b8bb97624b61833"
ref = "master"
repo = "https://github.com/yurihikari/garuda-hyprdots.git"

[requires]
fonts = [ "JetBrainsMonoNL Nerd Font Mono" ]

[[apps.cava.ops]]
group = "colors"
key = [ "color", "gradient" ]
priority = 80
set = 1

[[apps.cava.ops]]
group = "colors"
key = [ "color", "gradient_count" ]
priority = 80
set = 4

[[apps.cava.ops]]
group = "colors"
key = [ "color", "gradient_color_1" ]
priority = 80
set = "'#c6a0f6'"

[[apps.cava.ops]]
group = "colors"
key = [ "color", "gradient_color_2" ]
priority = 80
set = "'#f5bde6'"

[[apps.cava.ops]]
group = "colors"
key = [ "color", "gradient_color_3" ]
priority = 80
set = "'#f0c6c6'"

[[apps.cava.ops]]
group = "colors"
key = [ "color", "gradient_color_4" ]
priority = 80
set = "'#f4dbd6'"

[[apps.foot.ops]]
group = "spacing"
key = [ "cursor", "style" ]
priority = 50
set = "block"

[[apps.hyprland.ops]]
group = "layout"
key = [ "general", "border_size" ]
priority = 60
set = 2

[[apps.hyprland.ops]]
group = "layout"
key = [ "general", "gaps_in" ]
priority = 60
set = 5

[[apps.hyprland.ops]]
group = "layout"
key = [ "general", "gaps_out" ]
priority = 60
set = 10

[[apps.hyprland.ops]]
group = "colors"
key = [ "general", "col.active_border" ]
priority = 80
set = "0xFFB4A1DB 0xFFD04E9D 45deg"

[[apps.hyprland.ops]]
group = "colors"
key = [ "general", "col.inactive_border" ]
priority = 80
set = "1e2030 1e2030 45deg"

[[apps.hyprland.ops]]
group = "layout"
key = [ "decoration", "rounding" ]
priority = 60
set = 10

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "active_opacity" ]
priority = 50
set = "1.0"

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "inactive_opacity" ]
priority = 50
set = "0.8"

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "fullscreen_opacity" ]
priority = 50
set = "1.0"

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "dim_inactive" ]
priority = 50
set = false

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "dim_strength" ]
priority = 50
set = "0.5"

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "blur", "enabled" ]
priority = 50
set = true

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "blur", "size" ]
priority = 50
set = 16

[[apps.hyprland.ops]]
group = "animations"
key = [ "animations", "enabled" ]
priority = 40
set = true

[[apps.hyprland.ops]]
group = "misc"
key = [ "misc", "disable_hyprland_logo" ]
priority = 30
set = true

[[apps.hyprland.ops]]
group = "misc"
key = [ "misc", "disable_splash_rendering" ]
priority = 30
set = false

[[apps.hyprland.ops]]
add = [
    "windowsIn,1,5,default,popin 0%",
    "windowsOut,1,5,default,popin",
    "windowsMove,1,5,default,slide",
    "fadeIn,1,8,default",
    "fadeOut,1,8,default",
    "fadeSwitch,1,8,default",
    "fadeShadow,1,8,default",
    "fadeDim,1,8,default",
    "border,1,10,default",
    "workspaces,1,5,default,slide"
]
group = "animations"
key = "animation"
priority = 40

