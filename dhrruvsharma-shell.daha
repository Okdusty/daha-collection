# Drafted by `daha-cli import` from https://github.com/dhrruvsharma/shell.git at edef963c829482f4f4cbb20aa6e339024dc3ef2a.
# Their files stay in their repository: this pack points at them.
# A draft: review every op before publishing.
#   left out: hyprland: 2 general settings, 2 gestures settings, 2 group settings, 9 input settings, 1 master settings, 5 scrolling settings, 16 hl.animation calls, 62 hl.bind calls, 6 hl.curve calls, 1 hl.device calls, 17 hl.env calls, 1 hl.gesture calls, 1 hl.layer_rule calls, 1 hl.monitor calls, 1 hl.on calls, 6 hl.window_rule calls (not theme, or animations, which aren't taken from Lua yet)
#   left out: hyprland: 1 parts of its Lua need running to read (hypr/hyprland.lua:198: a for block isn't read (it would need running))
#   left out: kitty: 13 keyboard shortcuts, 3 other settings
#   left out: rofi: its theme @imports other files: review it
#   left out: cava: 24 settings that aren't its theme

daha = 1

[pack]
authors = [ "dhrruvsharma" ]
description = "Taken from dhrruvsharma/shell at edef963c8294, referenced there and not copied: only what themes an app.\n\n- hyprland: hypr/hyprland.lua and 2 module(s) it requires: 25 settings (read from its Lua, not run)\n- kitty: kitty/kitty.conf and 1 included file(s): 26 settings\n- rofi: rofi/themes/hypr-matugen-dark.rasi (its theme)\n- cava: cava/config: 12 settings\n\nLeft out: binds, startup commands, monitors, scripts and anything outside their repository."
desktops = [ "hyprland" ]
id = "com.github.okdusty.dhrruvsharma-shell"
license = "GPL-3.0"
name = "shell"
preview = [ "theme-wasteland", "theme-hud", "theme-terminal" ]
summary = "dhrruvsharma's rice: its look for hyprland, kitty, rofi and cava"
version = "1.0.0"

[source]
publishers = [ "gitlab.com/okdusty" ]
ref = "main"
repo = "https://github.com/Okdusty/daha-collection.git"

[upstream]
commit = "edef963c829482f4f4cbb20aa6e339024dc3ef2a"
ref = "master"
repo = "https://github.com/dhrruvsharma/shell.git"

[requires]
fonts = [ "JetBrains Mono Nerd Font" ]

[[apps.cava.ops]]
