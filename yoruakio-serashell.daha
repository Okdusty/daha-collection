# Drafted by `daha-cli import` from https://github.com/YoruAkio/Serashell.git at 917246cd1ef24d57586855f8893f8f245a170725.
# Their files stay in their repository: this pack points at them.
# A draft: review every op before publishing.
#   left out: hyprland: 1 dwindle settings, 3 general settings, 7 input settings, 2 master settings, 1 misc settings, 24 hl.bind calls, 1 hl.curve calls, 6 hl.env calls, 2 hl.monitor calls, 1 hl.on calls, 2 hl.window_rule calls (not theme, or animations, which aren't taken from Lua yet)
#   left out: hyprland: 13 parts of its Lua need running to read (config/monitors:4: a for block isn't read (it would need running), ...)
#   left out: kitty: 11 keyboard shortcuts, 4 other settings
#   left out: fuzzel: 7 settings that aren't its theme
#   left out: dunst: 49 settings that aren't its theme
#   left out: fastfetch: found config/fastfetch/config.jsonc, but the importer doesn't read fastfetch yet

daha = 1

[pack]
authors = [ "YoruAkio" ]
description = "Taken from YoruAkio/Serashell at 917246cd1ef2, referenced there and not copied: only what themes an app.\n\n- hyprland: config/hypr/hyprland.lua and 9 module(s) it requires: 11 settings (read from its Lua, not run)\n- kitty: config/kitty/kitty.conf and 1 included file(s): 35 settings\n- fuzzel: config/fuzzel/fuzzel.ini: 2 settings\n- dunst: config/dunst/dunstrc: 21 settings\n\nLeft out: binds, startup commands, monitors, scripts and anything outside their repository."
desktops = [ "hyprland" ]
id = "com.github.okdusty.yoruakio-serashell"
license = "MIT"
name = "Serashell"
summary = "YoruAkio's rice: its look for hyprland, kitty, fuzzel and dunst"
version = "1.0.0"

[source]
publishers = [ "gitlab.com/okdusty" ]
ref = "main"
repo = "https://github.com/Okdusty/daha-collection.git"

[upstream]
commit = "917246cd1ef24d57586855f8893f8f245a170725"
ref = "main"
repo = "https://github.com/YoruAkio/Serashell.git"

[requires]
fonts = [ "JetBrains Mono Nerd Font" ]

[[apps.dunst.ops]]
group = "spacing"
key = [ "global", "gap_size" ]
priority = 50
set = 10

[[apps.dunst.ops]]
group = "spacing"
key = [ "global", "padding" ]
priority = 50
set = 14

[[apps.dunst.ops]]
group = "spacing"
key = [ "global", "horizontal_padding" ]
priority = 50
set = 16

[[apps.dunst.ops]]
group = "colors"
key = [ "global", "text_icon_padding" ]
priority = 80
set = 12

[[apps.dunst.ops]]
group = "spacing"
key = [ "global", "frame_width" ]
priority = 50
set = 2

[[apps.dunst.ops]]
group = "colors"
key = [ "global", "frame_color" ]
priority = 80
set = "\"#2d4f67\""

[[apps.dunst.ops]]
group = "spacing"
key = [ "global", "corner_radius" ]
