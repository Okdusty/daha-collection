# Drafted by `daha-cli import` from https://github.com/parvizsudo/Aozora.git at 49056b8ec8bb719f954c6f58a6ee953b6f19d309.
# Their files stay in their repository: this pack points at them.
# A draft: review every op before publishing.
#   left out: hyprland: 2 binds settings, 4 cursor settings, 4 dwindle settings, 3 general settings, 15 input settings, 3 master settings, 12 misc settings, 5 scrolling settings, 1 xwayland settings, 14 hl.animation calls, 38 hl.bind calls, 7 hl.curve calls, 1 hl.device calls, 13 hl.env calls, 5 hl.gesture calls, 74 hl.layer_rule calls, 1 hl.monitor calls, 1 hl.on calls, 58 hl.window_rule calls, 1 hl.workspace_rule calls (not theme, or animations, which aren't taken from Lua yet)
#   left out: hyprland: 1 parts of its Lua need running to read (modules.binds:43: a for block isn't read (it would need running))
#   left out: kitty: 92 keyboard shortcuts, 5 mouse bindings, 44 other settings
#   left out: waybar: its config (modules, layout) isn't imported: that's a desktop, not a theme
#   left out: fastfetch: found config/fastfetch/config.jsonc, but the importer doesn't read fastfetch yet
#   left out: hyprlock: found config/hypr/hyprlock.conf, but the importer doesn't read hyprlock yet

daha = 1

[pack]
authors = [ "parvizsudo" ]
description = "Taken from parvizsudo/Aozora at 49056b8ec8bb, referenced there and not copied: only what themes an app.\n\n- hyprland: config/hypr/hyprland.lua and 11 module(s) it requires: 25 settings (read from its Lua, not run)\n- kitty: config/kitty/kitty.conf and 1 included file(s): 47 settings\n- waybar: config/waybar/style.css (the whole style)\n- cava: config/cava/config: 4 settings\n- swaync: config/swaync/style.css (the whole style)\n- wlogout: config/wlogout/style.css (the whole style)\n- wofi: config/wofi/style.css (the whole style)\n\nLeft out: binds, startup commands, monitors, scripts and anything outside their repository."
desktops = [ "hyprland" ]
id = "com.github.okdusty.parvizsudo-aozora"
license = "MIT"
name = "Aozora"
preview = [ "wm" ]
summary = "parvizsudo's rice: its look for hyprland, kitty, waybar, cava, swaync, wlogout and wofi"
version = "1.0.0"

[source]
publishers = [ "gitlab.com/okdusty" ]
ref = "main"
repo = "https://github.com/Okdusty/daha-collection.git"

[upstream]
commit = "49056b8ec8bb719f954c6f58a6ee953b6f19d309"
ref = "main"
repo = "https://github.com/parvizsudo/Aozora.git"

[requires]
fonts = [ "CaskaydiaMono Nerd Font" ]

