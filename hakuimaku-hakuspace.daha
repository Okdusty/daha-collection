set = "1.4"

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "blur", "noise" ]
priority = 50
set = "0.05"

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "blur", "special" ]
priority = 50
set = false

[[apps.hyprland.ops]]
group = "effects"
key = [ "decoration", "blur", "input_methods" ]
