[assets.hakubtop]
digest = "sha256:d268f433a034963ea149ae36f8e1104471e0974c764f9b082505e0883db037b9"
kind = "fragment"
path = "src/home/.config/btop/themes/HakuBtop.theme"
size = 329

[assets.style]
